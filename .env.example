# MPG アクセストークン（.env にコピーして使用。.env はコミット禁止）
#
# 取得手順:
#   1. ブラウザで https://mpg.football/ にログイン
#   2. DevTools を開く（F12）→ Console タブ
#   3. 次を実行してトークンを取り出す:
#        Object.entries(localStorage)
#          .filter(([k]) => k.includes('auth0'))
#          .map(([,v]) => JSON.parse(v)?.body?.access_token)
#          .filter(Boolean)[0]
#   4. 出力された文字列（eyJ... で始まる）を下に貼る
#
# トークンは数時間で失効する。失効したら取り直すこと。
MPG_TOKEN=

# 任意: API が api-version ヘッダを要求する場合のみ設定
# MPG_API_VERSION=
